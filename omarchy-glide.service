[Unit]
Description=Omarchy Glide mouse and keyboard sharing
Documentation=https://github.com/feschber/lan-mouse
PartOf=graphical-session.target
After=graphical-session.target
Wants=omarchy-glide-idle.service

[Service]
Type=simple
ExecStart=/usr/bin/systemd-inhibit --what=idle:sleep --mode=block --who=Glide '--why=Remote mouse control' %h/.local/bin/omarchy-glide-engine daemon
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=graphical-session.target
