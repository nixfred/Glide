[Unit]
Description=Glide LAN-only Omarchy session discovery
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.config/omarchy/plugins/nixfred.glide/scripts/discovery.py
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=graphical-session.target
