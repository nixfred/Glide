[Unit]
Description=Glide physical mouse and keyboard ownership
PartOf=omarchy-glide.service
After=omarchy-glide.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.config/omarchy/plugins/nixfred.glide/scripts/mouse-owner.py
Restart=on-failure
RestartSec=2
UMask=0077

[Install]
WantedBy=omarchy-glide.service
